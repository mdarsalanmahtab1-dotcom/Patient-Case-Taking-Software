# MediKiosk Backend — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit the real .env file to git.

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (get from https://www.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Allowed CORS origin for the frontend (set to your Vercel URL in production)
# Example: ALLOWED_ORIGIN=https://medikiosk.vercel.app
# For local dev, leave as * or http://localhost:5173
ALLOWED_ORIGIN=*
